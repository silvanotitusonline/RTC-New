# Copy to .env and replace these deployment values. Never commit .env.
NODE_ENV=production
PORT=3000
# Use the migration owner's connection for `npm run migrate`, and a restricted
# runtime connection for `npm start`. Percent-encode password URL characters.
DATABASE_URL=postgresql://rtc_app:replace-me@127.0.0.1:5432/rtc_api
PUBLIC_BASE_URL=https://api.your-rtc-domain.example
OIDC_ISSUER=https://your-project.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Must be a persistent volume; every replica must share the same mounted storage.
MEDIA_DIR=/var/lib/rtc/media
# Server-side TomTom Routing/Search key; do not bundle this key into the APK.
TOMTOM_API_KEY=
# Enable TLS for a remote PostgreSQL deployment. Never disable certificate checks.
PG_TLS=false
# PG_CA_FILE=/run/secrets/postgres-ca.pem
